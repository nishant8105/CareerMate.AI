# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration (Supabase / Render / Neon)
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Connection Parameters (Optional if DATABASE_URL is provided)
DB_HOST=db.your_project_ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password

# PostgreSQL Standard Connection Parameters
PGHOST=db.your_project_ref.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_password
