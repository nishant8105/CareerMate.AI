# Set default behavior to automatically normalize line endings to CRLF on Windows
* text=auto eol=crlf

# Explicit text file formats
*.py text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.yaml text eol=crlf
*.yml text eol=crlf
*.env text eol=crlf
*.example text eol=crlf
Procfile text eol=crlf
.gitignore text eol=crlf

# Binary file formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.db binary
*.pyc binary
